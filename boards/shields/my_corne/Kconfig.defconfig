if SHIELD_MY_CORNE_LEFT || SHIELD_MY_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Corne"

# the left half is central only in the setup without a dongle;
# for the dongle setup it is built with -DCONFIG_ZMK_SPLIT_ROLE_CENTRAL=n (see build.yaml)
config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_MY_CORNE_LEFT || SHIELD_MY_CORNE_RIGHT || SHIELD_MY_CORNE_DONGLE

config ZMK_SPLIT
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
