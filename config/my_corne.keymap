#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        macros {
                // types "n0fear" and presses Enter (System + N)
                macro_n0fear: macro_n0fear {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <10>;
                        tap-ms = <10>;
                        bindings = <&macro_tap &kp N &kp N0 &kp F &kp E &kp A &kp R &kp RET>;
                };

                // types "ls -ltrh" and presses Enter (Lower + D)
                macro_ls: macro_ls {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <10>;
                        tap-ms = <10>;
                        bindings = <&macro_tap &kp L &kp S &kp SPACE &kp MINUS &kp L &kp T &kp R &kp H &kp RET>;
                };
        };

        combos {
                compatible = "zmk,combos";

                // J + K + L -> Enter
                combo_enter {
                        timeout-ms = <50>;
                        key-positions = <19 20 21>;
                        bindings = <&kp RET>;
                        layers = <0>;
                };

                // Tab + Q -> ~
                combo_tilde {
                        timeout-ms = <50>;
                        key-positions = <0 1>;
                        bindings = <&kp TILDE>;
                        layers = <0>;
                };

                // D + F -> Alt+Shift
                combo_alt_shift {
                        timeout-ms = <50>;
                        require-prior-idle-ms = <150>;
                        key-positions = <15 16>;
                        bindings = <&kp LA(LSHFT)>;
                        layers = <0>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";

                // Lower + Raise -> System
                system {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  [   |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    |GUI/A| LWR | BSPC|   | SPC | RSE  | ENT |
// GUI/A: tap = GUI, hold = Alt
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp LBKT
   &kp LSHFT &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &mt LALT LGUI &mo 1 &kp BSPC   &kp SPACE &mo 2 &kp RET
                        >;
                };
                lower_layer {
                        display-name = "Lower";
// ?,ru / /.ru / &?ru: in the Russian layout these give "," "." "?" (Shift+/, /, Shift+7),
// in the English layout they give "?" "/" "&".
// LS: types "ls -ltrh" + Enter.
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | &?ru |
// | SHFT | HOME| END | LS  |     |     |   | LFT | DWN |  UP | RGT |     |      |
// | CTRL |     |     |     |     |     |   |     |     | ?,ru| /.ru|     |  -   |
//                    |     |     |     |   | DEL |     |     |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp LS(N7)
   &kp LSHFT  &kp HOME     &kp END      &macro_ls    &trans       &trans         &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LCTRL  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &kp LS(FSLH) &kp FSLH &trans &kp MINUS
                                    &trans       &trans       &trans         &kp DEL  &trans   &trans
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |      |
// | SHFT |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | CTRL |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |     |     |     |   |     |     |     |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &trans   &trans   &trans      &trans    &trans    &trans
                        >;
                };

                system_layer {
                        display-name = "System";
// -----------------------------------------------------------------------------------------
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   |     |  F7 |  F8 |  F9 | F10 |      |
// |      |WIN+L|WIN+P|     |     |     |   |     |  F4 |  F5 |  F6 | F11 |STUDIO|
// | BOOT |     |     |     |     |     |   |MACRO|  F1 |  F2 |  F3 | F12 | BOOT |
//                    |     | LWR |     |   |     | RSE |     |
// MACRO: types "n0fear" + Enter.
                        bindings = <
   &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &kp F7 &kp F8 &kp F9 &kp F10 &none
   &none       &kp LG(L)    &kp LG(P)    &none        &none        &none          &none &kp F4 &kp F5 &kp F6 &kp F11 &studio_unlock
   &bootloader &none        &none        &none        &none        &none          &macro_n0fear &kp F1 &kp F2 &kp F3 &kp F12 &bootloader
                                         &none        &trans       &none          &none &trans &none
                        >;
                };

                extra1 {
                        status = "reserved";
                };

                extra2 {
                        status = "reserved";
                };

                extra3 {
                        status = "reserved";
                };
        };
};
